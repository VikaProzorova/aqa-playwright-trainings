{
  "compilerOptions": {
    "module": "CommonJS",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "outDir": "dist",
    "moduleResolution": "node",
    "declaration": true,
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "exclude": ["dist"]
}
